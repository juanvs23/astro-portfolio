# Resend API Key - Get it from https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Google Tag Manager container id (gtm-integration)
# Empty (default) → no GTM markup is rendered anywhere. Set your GTM-XXXXXX
# container id to enable the head loader + noscript fallback + analytics events.
PUBLIC_GTM_CONTAINER_ID=

# Email configuration
FROM_EMAIL=contact@coltmandev.dev
TO_EMAIL=contact@coltmandev.dev

# N8N webhook for lead capture
# Public URL of the n8n webhook that receives lead data
PUBLIC_N8N_LEAD_WEBHOOK=your-n8n-webhook-url
# Basic auth credentials for the n8n webhook (must match N8N_BASIC_AUTH_USER/PASSWORD on n8n side)
N8N_AUTH_USER=your-auth-user
N8N_AUTH_PASS=your-auth-pass

# MongoDB (n8n workflow — used inside the n8n Code node, NOT by the Astro app)
MONGO_HOST=your-mongo-host:port
MONGO_DB=leads
MONGO_COLLECTION=leads
MONGO_AUTH_USER=admin
MONGO_AUTH_PASS=your-mongo-pass
