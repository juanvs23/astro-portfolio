---
import { getTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

const navLinks = [
  { label: t('mobile.about') as string, href: `/${locale}/about` },
  { label: t('about.skills') as string, href: `/${locale}/skills` },
  { label: t('mobile.services') as string, href: `/${locale}/services` },
  { label: t('projects.title') as string, href: `/${locale}/projects` },
  { label: t('mobile.contact') as string, href: `/${locale}/contact` },
];
---

<!-- D9: Minimal funnel footer mirroring Footer.astro pattern (caption-md + hairline)
     with localised linkouts to secondary pages. Home has no header/nav so these
     are the only navigation exits from the funnel. -->
<footer class="bg-canvas border-t border-hairline py-[32px]">
  <div class="max-w-[1200px] mx-auto px-lg">
    <p class="text-heading-md font-bold text-ink mb-lg">
      {t('funnel.footer.heading')}
    </p>

    <nav aria-label={locale === 'es' ? 'Navegación' : 'Navigation'} class="mb-xl">
      <ul class="flex flex-wrap gap-md">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-caption-md text-body no-underline hover:text-ink transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-sm border-t border-hairline pt-lg">
      <span class="text-caption-md text-mute">
        {t('funnel.footer.tagline')}
      </span>
    </div>
  </div>
</footer>
