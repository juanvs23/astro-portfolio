---
import { getTranslations, type Locale } from '@/i18n';
import { getSectionButtonDefs } from '@/constants';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

const defs = getSectionButtonDefs();

const buttons = defs.map((def) => ({
  ...def,
  label: t(def.key),
  href: `/${locale}/${def.path}`,
}));
---

<div
  id="section-buttons"
  role="navigation"
  aria-label={t('navigation.sections')}
  class="fixed top-[50%] left-0 right-0 h-[50%] md:top-[26%] md:h-[75%] flex items-center justify-center pointer-events-none z-30"
>
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 px-4 w-full lg:max-w-[50vw]">
    {buttons.map((btn) => (
      <a
        href={btn.href}
        title={btn.label}
        aria-label={btn.label}
        data-section={btn.label}
        class="pointer-events-auto flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-surface-dark/80 border border-on-dark-mute/30 text-on-dark text-sm font-medium hover:scale-110 hover:bg-surface-dark transition-all duration-200"
        set:html={btn.icon + `<span class="hidden md:inline">${btn.label}</span>`}
      />
    ))}
  </div>
</div>

<script>
  const buttons = document.querySelectorAll('#section-buttons a');

  buttons.forEach((btn) => {
    btn.addEventListener('mouseenter', () => {
      window.dispatchEvent(new CustomEvent('bubble-hover', { detail: btn.dataset.section }));
    });

    btn.addEventListener('mouseleave', () => {
      window.dispatchEvent(new CustomEvent('bubble-hover-end'));
    });
  });
</script>
