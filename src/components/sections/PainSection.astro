---
import { getTranslations, type Locale } from '@/i18n';
import Section from '../ui/Section.astro';
import AsciiMarker from '../ui/AsciiMarker.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
---

<Section id="pain">
  <div class="max-w-[760px]" data-aos="fade-up">
    <h2 class="text-heading-md font-bold text-ink mb-sm">
      <AsciiMarker state="remove" class="mr-xs inline" />
      {t('funnel.pain.heading')}
    </h2>
    <div class="border-b border-hairline mb-md" data-aos="fade-up" data-aos-delay="100"></div>
    <p class="text-body-md text-body mb-xl">{t('funnel.pain.description')}</p>

    <h2 class="text-heading-md font-bold text-ink mb-sm" data-aos="fade-up" data-aos-delay="150">
      <AsciiMarker state="add" class="mr-xs inline" />
      {t('funnel.promise.heading')}
    </h2>
    <div class="border-b border-hairline mb-md" data-aos="fade-up" data-aos-delay="200"></div>
    <p class="text-body-md text-body" data-aos="fade-up" data-aos-delay="250">
      {t('funnel.promise.description')}
    </p>
  </div>
</Section>
