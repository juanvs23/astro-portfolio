---
import { Image } from 'astro:assets';
import { getTranslations, type Locale } from "@/i18n";
import { getPreviewImageSpec } from "@/lib/preview-images";
import aboutme from "../../assets/img/aboutme.jpg";
import Section from "../ui/Section.astro";
import AsciiMarker from "../ui/AsciiMarker.astro";
import CtaButton from "../ui/CtaButton.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
const spec = getPreviewImageSpec('about');
const alt = String(t(spec.altKey));
---

<Section id="about-preview">
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-xl items-center"
    data-reveal
  >
    <!-- Imagen -->
    <div
      class="order-1 bg-surface-soft border border-hairline rounded-sm aspect-video overflow-hidden"
      data-reveal-item
    >
      <Image
        src={aboutme}
        alt={alt}
        width={spec.width}
        densities={spec.densities}
        formats={spec.formats}
        loading="lazy"
        class="w-full h-full object-cover rounded-sm"
      />
    </div>

    <!-- Texto -->
    <div class="order-2" data-reveal-item>
      <h2 class="text-xl md:text-3xl font-bold text-ink mb-sm">
        <AsciiMarker state="add" class="mr-xs inline" />
        {t("funnel.about.heading")}
      </h2>
      <div class="border-b border-hairline mb-md"></div>
      <p class="text-body-md text-body mb-xl">
        {t("funnel.about.description")}
      </p>

      <CtaButton
        href={`/${locale}/about`}
        variant="dark"
        class="block text-center py-sm px-lg font-bold mt-lg w-fit"
      >
        {t("funnel.about.linkout")}
        <span aria-hidden="true">&rarr;</span>
      </CtaButton>
    </div>
  </div>
</Section>
