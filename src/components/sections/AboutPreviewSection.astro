---
import { getTranslations, type Locale } from '@/i18n';
import Section from '../ui/Section.astro';
import AsciiMarker from '../ui/AsciiMarker.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
---

<Section id="about-preview">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-xl items-center" data-aos="fade-up">
    <!-- Imagen (placeholder — se reemplaza cuando tengas el asset) -->
    <div class="order-1 bg-surface-soft border border-hairline rounded-sm aspect-video flex items-center justify-center">
      <span class="text-mute text-body-md">img</span>
    </div>

    <!-- Texto -->
    <div class="order-2">
      <h2 class="text-xl md:text-3xl font-bold text-ink mb-sm">
        <AsciiMarker state="add" class="mr-xs inline" />
        {t('funnel.about.heading')}
      </h2>
      <div class="border-b border-hairline mb-md"></div>
      <p class="text-body-md text-body mb-xl">{t('funnel.about.description')}</p>

      <a
        href={`/${locale}/about`}
        class="inline-flex items-center justify-center gap-2 px-lg py-sm rounded-sm font-mono text-body-md font-medium border border-hairline bg-surface-dark text-on-dark hover:bg-surface-dark-elevated hover:text-on-dark hover:border-accent transition-all"
      >
        {t('funnel.about.linkout')}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</Section>