---
import { getTranslations, type Locale } from '@/i18n';
import Input from '../ui/Input.astro';
import CtaButton from '../ui/CtaButton.astro';

interface Props {
  locale: Locale;
  formId: string;
  context: 'audit' | 'contact';
}

const { locale, formId, context } = Astro.props;
const t = await getTranslations(locale);

const isAudit = context === 'audit';
const waNumber = t('contact.whatsappNumber') as string;
const waMessage = isAudit
  ? (t('funnel.audit.message') as string)
  : (t('funnel.contact.message') as string);

const source = isAudit ? 'audit' : 'contact';
const staticHref = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;
const ctaLabel = t('funnel.contact.cta') as string;
const nameLabel = t('inputField.fullName') as string;
const emailLabel = t('inputField.email') as string;
const waNumberAttr = waNumber;

// i18n for inline script (SweetAlert2 modal, button loading, WA labels)
const waNameLabel = t('funnel.leadForm.waLabels.name') as string;
const waEmailLabel = t('funnel.leadForm.waLabels.email') as string;
const modalTitle = t('funnel.leadForm.modal.title') as string;
const modalBody = t('funnel.leadForm.modal.body') as string;
const modalConfirm = t('funnel.leadForm.modal.confirmText') as string;
const btnLoading = t('funnel.leadForm.button.loading') as string;
---

<div id={formId} class="space-y-lg" data-wa-number={waNumberAttr} data-wa-message={waMessage} data-source={source}>
  <Input
    name={`${formId}-name`}
    label={nameLabel}
    required
  />
  <Input
    name={`${formId}-email`}
    label={emailLabel}
    type="email"
    required
  />

  <CtaButton
    href={staticHref}
    variant="primary"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-2 px-lg h-[44px] text-sm"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="shrink-0">
      <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
    </svg>
    {ctaLabel}
  </CtaButton>
</div>

<script is:inline define:vars={{ waNameLabel, waEmailLabel, modalTitle, modalBody, modalConfirm, btnLoading }}>
  (function () {
    // Load Swal + Confetti from CDN before wiring forms
    var swalReady = false;
    var confettiReady = false;
    var onReadyCallbacks = [];

    function tryReady() {
      if (typeof Swal !== 'undefined') swalReady = true;
      if (typeof confetti !== 'undefined') confettiReady = true;
      if (swalReady && confettiReady) {
        onReadyCallbacks.forEach(function (fn) { fn(); });
        onReadyCallbacks = [];
      }
    }

    function onLibsReady(fn) {
      if (swalReady && confettiReady) { fn(); return; }
      onReadyCallbacks.push(fn);
    }

    // Inject SweetAlert2 CSS
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css';
    document.head.appendChild(link);

    // Inject SweetAlert2 JS
    var swalScript = document.createElement('script');
    swalScript.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
    swalScript.onload = function () { swalReady = true; tryReady(); };
    document.head.appendChild(swalScript);

    // Inject Confetti JS
    var confScript = document.createElement('script');
    confScript.src = 'https://cdn.jsdelivr.net/npm/canvas-confetti@1';
    confScript.onload = function () { confettiReady = true; tryReady(); };
    document.head.appendChild(confScript);

    function buildWaUrl(baseMsg, number, name, email) {
      var msg = baseMsg;
      if (name) msg += '%0A%0A' + waNameLabel + '%20' + encodeURIComponent(name);
      if (email) msg += '%0A' + waEmailLabel + '%20' + encodeURIComponent(email);
      return 'https://wa.me/' + number + '?text=' + msg;
    }

    function fireConfetti() {
      if (typeof confetti === 'undefined') return;
      confetti({ particleCount: 80, spread: 70, origin: { x: 0, y: 0.6 } });
      confetti({ particleCount: 80, spread: 70, origin: { x: 1, y: 0.6 } });
      setTimeout(function () {
        confetti({ particleCount: 100, spread: 100, origin: { x: 0.5, y: 0.5 } });
      }, 200);
    }

    function showModal(waUrl) {
      fireConfetti();
      Swal.fire({
        icon: 'success',
        title: modalTitle,
        text: modalBody,
        confirmButtonText: modalConfirm,
        background: '#f8f7f7',
        color: '#201d1d',
        iconColor: '#201d1d',
        confirmButtonColor: '#201d1d',
        allowOutsideClick: true,
        showCloseButton: true,
        customClass: {
          popup: 'rounded-sm border border-hairline',
          title: 'font-mono text-lg font-bold',
          htmlContainer: 'font-mono text-sm text-body',
          confirmButton: 'font-mono text-sm rounded-sm px-lg h-10',
          closeButton: 'text-mute',
        },
      }).then(function (result) {
        if (result.isConfirmed || result.isDismissed) {
          window.open(waUrl, '_blank');
        }
      });
    }

    function setupForms() {
      var containers = document.querySelectorAll('[data-wa-number]');
      containers.forEach(function (container) {
        if (container.dataset.wired === '1') return;
        container.dataset.wired = '1';

        var number = container.getAttribute('data-wa-number');
        var baseMsg = container.getAttribute('data-wa-message');
        var source = container.getAttribute('data-source');
        if (!number || !baseMsg) return;

        var nameInput = container.querySelector('input[id$="-name"]');
        var emailInput = container.querySelector('input[id$="-email"]');
        var btn = container.querySelector('a[href*="wa.me"]');
        if (!btn) return;

        function updateHref() {
          var n = (nameInput && nameInput.value || '').trim();
          var e = (emailInput && emailInput.value || '').trim();
          btn.setAttribute('href', buildWaUrl(baseMsg, number, n, e));
        }

        if (nameInput) nameInput.addEventListener('input', updateHref);
        if (emailInput) emailInput.addEventListener('input', updateHref);

        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          // gtm-integration (R4/R5): the CTA never bubbles to the delegated
          // wa.me listener (stopPropagation above), so push the conversion
          // event here via the bridge exposed by gtm-client.ts. No-op when
          // GTM is not configured (window.__gtmPush undefined).
          if (window.__gtmPush) {
            window.__gtmPush(source === 'audit' ? 'audit_cta' : 'contact_whatsapp_cta');
          }
          var name = (nameInput && nameInput.value || '').trim();
          if (!name) { nameInput.focus(); return; }
          var email = (emailInput && emailInput.value || '').trim();
          var waUrl = buildWaUrl(baseMsg, number, name, email);

          var originalText = btn.innerHTML;
          btn.textContent = btnLoading;
          btn.style.pointerEvents = 'none';

          fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, email: email, source: source }),
          })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data.success) throw new Error('not ok');
            // Clean form
            if (nameInput) nameInput.value = '';
            if (emailInput) emailInput.value = '';
            updateHref();
            // Show modal once libs are loaded
            onLibsReady(function () { showModal(waUrl); });
          })
          .catch(function () {
            window.open(waUrl, '_blank');
          })
          .finally(function () {
            btn.innerHTML = originalText;
            btn.style.pointerEvents = '';
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupForms);
    } else {
      setupForms();
    }
    document.addEventListener('astro:page-load', setupForms);
  })();
</script>
