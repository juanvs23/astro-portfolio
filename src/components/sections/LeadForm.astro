---
import { getTranslations, type Locale } from '@/i18n';
import Input from '../ui/Input.astro';
import AsciiMarker from '../ui/AsciiMarker.astro';
import { buildWhatsAppLink } from '../../lib/funnel-lead';

interface Props {
  locale: Locale;
  formId: string;
  context: 'audit' | 'contact';
}

const { locale, formId, context } = Astro.props;
const t = await getTranslations(locale);

// Lead-form copy. Subject/message are passed through to the pure payload
// builder so the module stays localized (D4). The hybrid WhatsApp link is
// built server-side and stays visible beside the form at all times (D5) as a
// no-JS / backend-failure conversion path.
const leadVars = {
  context,
  formId,
  nameId: `${formId}-name`,
  emailId: `${formId}-email`,
  nameRequired: t('formMessageErrors.field') as string,
  emailInvalid: t('formMessageErrors.email') as string,
  formMessages: {
    sending: t('contact.form.sending'),
    success: t('contact.form.success'),
    error: t('contact.form.error'),
    networkError: t('contact.form.networkError'),
  },
  payload: {
    subject:
      context === 'audit'
        ? (t('funnel.audit.subject') as string)
        : (t('funnel.contact.subject') as string),
    message:
      context === 'audit'
        ? (t('funnel.audit.message') as string)
        : (t('funnel.contact.message') as string),
  },
};

const submitLabel =
  context === 'audit'
    ? (t('funnel.audit.cta') as string)
    : (t('funnel.contact.cta') as string);

// Hybrid WhatsApp fallback. Visible regardless of form state so the visitor is
// never left without a conversion path (lead-capture spec).
const waHref = buildWhatsAppLink(
  t('contact.whatsappNumber') as string,
  (context === 'audit'
    ? t('funnel.audit.message')
    : t('funnel.contact.message')) as string,
);

const leadVarsJson = JSON.stringify(leadVars);
---
<form id={formId} class="space-y-lg" novalidate>
  <Input
    name={`${formId}-name`}
    label={t('inputField.fullName')}
    required
  />
  <Input
    name={`${formId}-email`}
    label={t('inputField.email')}
    type="email"
    required
  />

  <div class="flex flex-col sm:flex-row items-stretch gap-md">
    <button
      type="submit"
      class="inline-flex items-center justify-center gap-2 px-lg h-[44px] rounded-sm font-mono text-body-md font-medium bg-primary text-on-primary border border-hairline-strong hover:bg-canvas hover:text-ink hover:border-accent transition-all"
    >
      <AsciiMarker state="add" class="mr-xs inline" />
      {submitLabel}
    </button>

    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 px-lg h-[44px] rounded-sm font-mono text-body-md font-medium border border-hairline bg-surface-dark text-on-dark hover:bg-surface-dark-elevated hover:border-accent transition-all"
    >
      <AsciiMarker state="remove" class="mr-xs inline" />
      {t('funnel.contact.cta')}
    </a>
  </div>

  <p
    id={`${formId}-status`}
    class="min-h-[24px] text-body-md"
    role="status"
    aria-live="polite"
  ></p>
</form>

<script is:inline define:vars={{ leadVarsJson }}>
  window.__leadVars = JSON.parse(leadVarsJson);
</script>
<script>
  import { validateLead, buildFunnelContactPayload } from '../../lib/funnel-lead';
  import { submitContactForm } from '../../lib/contact-form';

  /* @ts-ignore */
  const leadVars = window.__leadVars;

  const form = document.getElementById(leadVars.formId) as HTMLFormElement;
  const statusEl = document.getElementById(
    leadVars.formId + '-status',
  ) as HTMLElement;
  const nameInput = document.getElementById(leadVars.nameId) as HTMLInputElement;
  const emailInput = document.getElementById(
    leadVars.emailId,
  ) as HTMLInputElement;

  function setStatus(message: string, tone: string): void {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove('text-success', 'text-danger', 'text-mute');
    statusEl.classList.add(tone);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const validation = validateLead(
      { name: nameInput?.value || '', email: emailInput?.value || '' },
      {
        nameRequired: leadVars.nameRequired,
        emailInvalid: leadVars.emailInvalid,
      },
    );
    if (!validation.valid) {
      const message = validation.errors?.name || validation.errors?.email || '';
      setStatus(message, 'text-danger');
      return;
    }

    await submitContactForm(
      buildFunnelContactPayload(
        { name: nameInput.value, email: emailInput.value },
        leadVars.context as 'audit' | 'contact',
        leadVars.payload,
      ),
      leadVars.formMessages,
      (status) => {
        if (status.state === 'sending') {
          setStatus(status.message, 'text-mute');
          return;
        }
        if (status.state === 'success') {
          form.reset();
          setStatus(status.message, 'text-success');
          return;
        }
        // error / networkError: keep the WhatsApp fallback visible below so the
        // visitor always has a conversion path. The link is never removed.
        setStatus(status.message, 'text-danger');
      },
    );
  });
</script>