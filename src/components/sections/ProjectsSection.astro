---
import { getTranslations, type Locale } from "@/i18n";
import Section from "../ui/Section.astro";
import ProjectItem from "../ui/ProjectItem.astro";
import { getProjects } from "@/lib/content/projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

// Projects come from the WordPress headless API at build time
// (Zod-validated, visible-only for this site, sorted by WP menu order),
// with the committed snapshot as fallback — see src/lib/content/projects.ts.
const projects = await getProjects("portfolio");
---

<Section id="projects">
  <h1
    data-typewriter
    data-aos="fade-down"
    class="text-h1 md:text-h1-md lg:text-h1-lg font-bold mb-sm"
  >
    {t("seo.h1.projects")}
  </h1>

  <div
    class="border-b border-hairline mb-xl"
    data-aos="fade-up"
    data-aos-delay="100"
  >
  </div>

  <p
    class="text-body-md text-body mb-xl"
    data-aos="fade-up"
    data-aos-delay="150"
  >
    {t("projects.subtitle")}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-xl">
    {
      projects.map((project) => {
        const localizedProject = {
          name: project.name,
          url: project.url,
          desc: locale === "en" ? project.desc.en : project.desc.es,
          imageUrl: project.imageUrl,
          imageWidth: project.imageWidth,
          imageHeight: project.imageHeight,
        };
        return (
          <ProjectItem textButton={t("projects.button")} project={localizedProject} />
        );
      })
    }
  </div>
</Section>
