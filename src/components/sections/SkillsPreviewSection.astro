---
import { Image } from 'astro:assets';
import { getTranslations, type Locale } from '@/i18n';
import { getPreviewImageSpec } from '@/lib/preview-images';
import cesdeProyectos from '../../assets/img/cesde-proyectos.jpg';
import Section from '../ui/Section.astro';
import AsciiMarker from '../ui/AsciiMarker.astro';
import CtaButton from '../ui/CtaButton.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
const spec = getPreviewImageSpec('skills');
const alt = String(t(spec.altKey));
---

<Section id="skills-preview">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-xl items-center" data-reveal>
    <!-- Texto (izquierda en desktop) -->
    <div class="order-2 md:order-1" data-reveal-item>
      <h2 class="text-xl md:text-3xl font-bold text-ink mb-sm">
        <AsciiMarker state="add" class="mr-xs inline" />
        {t('about.skills')}
      </h2>
      <div class="border-b border-hairline mb-md"></div>
      <p class="text-body-md text-body mb-xl">{t('funnel.proof.benefits')}</p>

      <CtaButton
        href={`/${locale}/skills`}
        variant="dark"
        class="inline-flex items-center justify-center gap-2 px-lg py-sm"
      >
        {t('about.skillsLink')}
        <span aria-hidden="true">&rarr;</span>
      </CtaButton>
    </div>

    <!-- Imagen (derecha en desktop, arriba en mobile) -->
    <div class="order-1 md:order-2 bg-surface-soft border border-hairline rounded-sm aspect-video overflow-hidden" data-reveal-item>
      <Image
        src={cesdeProyectos}
        alt={alt}
        width={spec.width}
        densities={spec.densities}
        formats={spec.formats}
        loading="lazy"
        class="w-full h-full object-cover rounded-sm"
      />
    </div>
  </div>
</Section>