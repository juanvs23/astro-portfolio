---
import { Image } from 'astro:assets';
import { getTranslations, type Locale } from '@/i18n';
import { getPreviewImageSpec } from '@/lib/preview-images';
import thinkous from '../../assets/img/thinkous.jpg';
import Section from '../ui/Section.astro';
import AsciiMarker from '../ui/AsciiMarker.astro';
import LeadForm from './LeadForm.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
const spec = getPreviewImageSpec('capture');
const alt = String(t(spec.altKey));
---

<Section id="audit">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-xl items-start" data-reveal>
    <!-- Texto + form (izquierda desktop, abajo mobile) -->
    <div class="order-2 md:order-1" data-reveal-item>
      <h2 class="text-xl md:text-3xl font-bold text-ink mb-sm">
        <AsciiMarker state="add" class="mr-xs inline" />
        {t('funnel.audit.heading')}
      </h2>
      <div class="border-b border-hairline mb-md"></div>
      <p class="text-body-md text-body mb-xl">{t('funnel.audit.description')}</p>

      <div class="bg-surface-soft border border-hairline rounded-sm p-lg">
        <LeadForm locale={locale} formId="audit-form" context="audit" />
      </div>
    </div>

    <!-- Imagen (derecha desktop, arriba mobile) -->
    <div class="order-1 md:order-2 bg-surface-soft border border-hairline rounded-sm aspect-video overflow-hidden" data-reveal-item>
      <Image
        src={thinkous}
        alt={alt}
        width={spec.width}
        densities={spec.densities}
        formats={spec.formats}
        loading="lazy"
        class="w-full h-full object-cover rounded-sm"
      />
    </div>
  </div>
</Section>