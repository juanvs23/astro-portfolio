---
import { getTranslations, type Locale } from "@/i18n";
import { buildWhatsAppLink } from "@/lib/funnel-lead";
import { getWhatsAppNumber } from "@/lib/whatsapp";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import AsciiMarker from "../ui/AsciiMarker.astro";
import CtaButton from "../ui/CtaButton.astro";

interface ExpressService {
  name: string;
  description: string;
}

interface ProcessStep {
  step: number;
  title: string;
  description: string;
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
const whatsappNumber = getWhatsAppNumber();

const express = t.object("services.express") as ExpressService[];
const processSteps = t.object("services.process") as ProcessStep[];
const customWork = t.object("services.custom") as {
  heading: string;
  description: string;
  cta: string;
  whatsappMessage: string;
};
const expressHeading = t("services.expressHeading");
const expressCtaLabel = t("services.expressCtaLabel");
const expressWaTemplate = t("services.expressWhatsappMessageTemplate");
const processHeading = t("services.processHeading");
---

<Section id="services">
  <!-- Custom work -->
  <section data-aos="fade-up" data-aos-delay="100">
    <SectionHeading variant="category" as="h2" marker="add" underline
      >{customWork.heading}</SectionHeading
    >
    <div class="bg-surface-soft border border-hairline rounded-sm p-lg md:p-xl">
      <p class="text-body-md text-body mb-lg max-w-2xl">
        {customWork.description}
      </p>
      <CtaButton
        href={buildWhatsAppLink(
          whatsappNumber,
          customWork.whatsappMessage,
        )}
        variant="dark"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block py-sm px-lg font-bold"
      >
        {customWork.cta}
      </CtaButton>
    </div>
  </section>

  <!-- Express services -->
  <section class="mt-section" data-aos="fade-up" data-aos-delay="100">
    <SectionHeading variant="category" as="h2" marker="add" underline
      >{expressHeading}</SectionHeading
    >

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-lg">
      {
        express.map((svc) => (
          <div class="bg-surface-soft border border-hairline rounded-sm p-md flex flex-col">
            <h3 class="text-h3 lg:text-h3-lg font-bold text-ink mb-xs">
              <AsciiMarker state="done" class="mr-xs text-ink" />
              {svc.name}
            </h3>
            <p class="text-caption-md text-mute flex-1 mb-md">
              {svc.description}
            </p>
            <a
              href={buildWhatsAppLink(
                whatsappNumber,
                expressWaTemplate.replace("{name}", svc.name),
              )}
              target="_blank"
              rel="noopener noreferrer"
              class="text-caption-md text-accent font-bold hover:underline inline-flex items-center gap-xs"
            >
              {expressCtaLabel}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Process steps -->
  <section class="mt-section" data-aos="fade-up" data-aos-delay="100">
    <SectionHeading variant="category" as="h2" marker="add" underline
      >{processHeading}</SectionHeading
    >

    <div class="grid grid-cols-1 md:grid-cols-3 gap-xl">
      {
        processSteps.map((step) => (
          <div class="bg-surface-soft border border-hairline rounded-sm p-lg text-center">
            <div
              class="text-[36px] font-bold text-accent mb-sm"
              aria-hidden="true"
            >
              {String(step.step).padStart(2, "0")}
            </div>
            <h3 class="text-h3 lg:text-h3-lg font-bold text-ink mb-xs">
              {step.title}
            </h3>
            <p class="text-caption-md text-mute">{step.description}</p>
          </div>
        ))
      }
    </div>
  </section>
</Section>
