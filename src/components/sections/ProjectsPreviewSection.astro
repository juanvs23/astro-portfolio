---
import { getTranslations, type Locale } from '@/i18n';
import Section from '../ui/Section.astro';
import AsciiMarker from '../ui/AsciiMarker.astro';
import CtaButton from '../ui/CtaButton.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
---

<Section id="projects-preview">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-xl items-center" data-aos="fade-up">
    <!-- Imagen (izquierda desktop, arriba mobile) -->
    <div class="order-1 bg-surface-soft border border-hairline rounded-sm aspect-video flex items-center justify-center">
      <span class="text-mute text-body-md">img</span>
    </div>

    <!-- Texto (derecha desktop, abajo mobile) -->
    <div class="order-2">
      <h2 class="text-xl md:text-3xl font-bold text-ink mb-sm">
        <AsciiMarker state="add" class="mr-xs inline" />
        {t('funnel.projects.heading')}
      </h2>
      <div class="border-b border-hairline mb-md"></div>
      <p class="text-body-md text-body mb-xl">{t('funnel.projects.description')}</p>

      <CtaButton
        href={`/${locale}/projects`}
        variant="dark"
        class="inline-flex items-center justify-center gap-2 px-lg py-sm"
      >
        {t('funnel.projects.linkout')}
        <span aria-hidden="true">&rarr;</span>
      </CtaButton>
    </div>
  </div>
</Section>