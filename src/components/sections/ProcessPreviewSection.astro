---
import { getTranslations, type Locale } from '@/i18n';
import Section from '../ui/Section.astro';
import AsciiMarker from '../ui/AsciiMarker.astro';

interface ProcessStep {
  step: number;
  title: string;
  description: string;
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);
const steps = t('services.process') as ProcessStep[];
---

<Section id="process">
  <div data-aos="fade-up">
    <h2 class="text-xl md:text-3xl font-bold text-ink mb-sm">
      <AsciiMarker state="add" class="mr-xs inline" />
      {t('funnel.process.heading')}
    </h2>
    <div class="border-b border-hairline mb-md" data-aos="fade-up" data-aos-delay="100"></div>
    <p class="text-body-md text-body mb-xl">{t('funnel.process.intro')}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-xl" data-aos="fade-up" data-aos-delay="150">
    {steps.map((step) => (
      <div class="bg-surface-soft border border-hairline rounded-sm p-lg">
        <div class="text-[36px] font-bold text-accent mb-sm" aria-hidden="true">
          {String(step.step).padStart(2, '0')}
        </div>
        <h3 class="text-heading-md font-bold text-ink mb-xs">{step.title}</h3>
        <p class="text-caption-md text-mute">{step.description}</p>
      </div>
    ))}
  </div>
</Section>