---
import { getTranslations, type Locale } from "@/i18n";
import Badge from "../ui/Badge.astro";
import CtaButton from "../ui/CtaButton.astro";
import HeroCursor from "../ui/HeroCursor.astro";
import { buildWhatsAppLink } from "@/lib/funnel-lead";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await getTranslations(locale);

// Primary above-the-fold CTA: WhatsApp deep-link. The full audit form (Capture
// section) arrives in a later PR; `funnel.hero.cta` label reuses the same
// lead path the funnel centralizes. (D4/D5 — number + copy from i18n.)
const ctaHref = buildWhatsAppLink(
  t("contact.whatsappNumber"),
  t("funnel.audit.message"),
);
---

<section
  id="hero"
  class="bg-surface-dark text-on-dark relative overflow-hidden min-h-[60dvh] flex items-center justify-center"
>
  <!-- Lateral matrix stream depth layer (home-hero-redesign): decorative
       canvas, aria-hidden, no interaction. Driven by createMatrixStream
       from the BaseLayout module script (reduced-motion → static grid). -->
  <canvas
    id="hero-matrix"
    class="hero-matrix pointer-events-none absolute inset-0 z-0"
    aria-hidden="true"
  ></canvas>

  <!-- Hero-scoped white invert cursor follower (decoration, aria-hidden). -->
  <HeroCursor />

  <!-- Hero content: badge/p/CTA start hidden (JS-driven) and fade in
       staggered after the h1 typewriter dispatches typewriter:done. -->
  <div
    class="relative z-10 flex w-full max-w-[1200px] mx-auto flex-col items-center px-lg py-xxl text-center"
  >
    <Badge variant="news" class="mb-lg" data-fade-after-type>
      {t("hero.badge")}
    </Badge>

    <h1
      class="block max-w-[700px] text-[28px] md:text-display-xl font-bold leading-[1.5] mb-xl min-h-[168px] md:min-h-[114px]"
    >
      <span class="inline-block" data-typewriter>{t("hero.title")}</span>
    </h1>

    <p
      class="max-w-[640px] text-body-md text-on-dark-mute mb-xxl"
      data-fade-after-type
    >
      {t("hero.description")}
    </p>

    <CtaButton
      href={ctaHref}
      variant="light"
      target="_blank"
      rel="noopener"
      pulse
      data-fade-after-type
      class="inline-flex items-center justify-center gap-2 px-lg h-[44px]"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="shrink-0">
        <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      <span>{t("funnel.hero.cta")}</span>
    </CtaButton>
  </div>
</section>
