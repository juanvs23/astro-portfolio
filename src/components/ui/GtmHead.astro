---
// GTM head loader (gtm-integration, spec R1). Renders only when
// PUBLIC_GTM_CONTAINER_ID is non-empty; the container id is never hardcoded.
// set:html inserts the raw loader so Astro never bundles/transforms it.
const containerId = import.meta.env.PUBLIC_GTM_CONTAINER_ID as string | undefined;

const loaderSnippet = containerId
  ? `<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${containerId}');</script>`
  : '';
---

{containerId ? <Fragment set:html={loaderSnippet} /> : null}