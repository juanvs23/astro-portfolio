---
import '../styles/global.css';
import { getTranslations, type Locale } from '@/i18n';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = 'Juan Carlos Ávila – Full Stack Developer',
  description = 'Desarrollador Full Stack con 6+ años de experiencia | PHP, Python, JavaScript (React, Next.js), WordPress, Laravel & Django',
  locale = 'es',
} = Astro.props;

const t = await getTranslations(locale);
const seoTitle = t('seo.title');
const seoDescription = t('seo.description');
const finalTitle = title === 'Juan Carlos Ávila – Full Stack Developer' ? seoTitle : title;
const finalDescription = description === 'Desarrollador Full Stack con 6+ años de experiencia | PHP, Python, JavaScript (React, Next.js), WordPress, Laravel & Django' ? seoDescription : description;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="author" content="Juan Carlos Ávila" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://coltmandev.dev${Astro.url.pathname}`} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:url" content={`https://coltmandev.dev${Astro.url.pathname}`} />
    <meta property="og:image" content="https://coltmandev.dev/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content="https://coltmandev.dev/og-image.jpg" />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="font-mono bg-canvas text-ink antialiased">
    <!-- D7: no-JS fallback. AOS CSS zeroes [data-aos] opacity before init; without scripting,
         content must stay visible/reachable. Style inside noscript is body-valid HTML5. -->
    <noscript>
      <style>
        [data-aos] { opacity: 1 !important; transform: none !important; }
        [data-reveal-item] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-lg focus:py-md focus:bg-surface-dark focus:text-on-dark focus:rounded-sm">
      {t('navigation.skipToContent')}
    </a>
    <div id="main-content">
      <slot />
    </div>
    <script is:inline>
      function initAOS() {
        try {
          window.__AOS.init({ duration: 600, once: true });
        } catch(e) {
          console.warn('AOS init error:', e);
        }
      }

      function initUnderlines() {
        var els = document.querySelectorAll('[data-underline]');
        if (!els.length) return;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });
        els.forEach(function(el) { observer.observe(el); });
      }

      document.addEventListener('astro:page-load', function() {
        initAOS();
        initUnderlines();
      });
    </script>
    <script>
      import AOS from 'aos';
      window.__AOS = AOS;
    </script>
    <script>
      import { shouldEnableMotion } from '@/lib/motion-guard';
      import { onInView, staggerDelay } from '@/lib/viewport';
      import { createMatrixStream } from '@/lib/matrix-stream';

      // Home Motion One lifecycle (home-visual-polish): staggered [data-reveal]
      // reveals and the one-time CTA pulse. Dynamic import('motion/mini')
      // code-splits the ~5KB gzip runtime into a lazy chunk fetched only when
      // the reduced-motion guard passes; the reveal trigger is the tiny
      // IntersectionObserver helper in viewport.ts. Mirrors the AOS init
      // pattern in this file: init on astro:page-load, dispose on
      // astro:before-swap so View Transitions never leak running animations.
      function initHomeMotion() {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (!shouldEnableMotion(reduce.matches)) return; // CSS shows static states
        window.__typewriterDone = false; // fresh page state (window survives VT)

        import('motion/mini').then(function (m) {
          var stops = [];
          var anims = [];
          var revealGrids = document.querySelectorAll('[data-reveal]');
          revealGrids.forEach(function (grid) {
            var items = grid.querySelectorAll('[data-reveal-item]');
            if (!items.length) return;
            var stop = onInView(grid, function () {
              items.forEach(function (item, i) {
                anims.push(m.animate(item, { opacity: 1, y: 0 }, { delay: staggerDelay(i), duration: 0.5 }));
              });
            }, { amount: 0.2 });
            stops.push(stop);
          });

          var pulseEl = document.querySelector('[data-cta-pulse]');
          if (pulseEl) {
            anims.push(m.animate(pulseEl, { scale: [1, 1.04, 1] }, { duration: 1, delay: 0.4 }));
          }

          initHeroFadeIn(m, anims);
          initTerminalLines(m, anims, stops);
          window.__homeMotion = { stops: stops, anims: anims };
        });
      }

      // Terminal window line reveal (home-skills-terminal): lines type out one
      // by one (~220ms apart, 160–380ms cadence) once the terminal enters the
      // viewport, sharing the same Motion One inView lifecycle as the section
      // reveals. Lines are hidden via Motion only, so reduced-motion and no-JS
      // render everything visible immediately.
      function initTerminalLines(m, anims, stops) {
        var terminals = document.querySelectorAll('[data-terminal]');
        terminals.forEach(function (term) {
          var lines = term.querySelectorAll('[data-terminal-line]');
          if (!lines.length) return;
          m.animate(lines, { opacity: 0 }, { duration: 0 });
          var stop = onInView(term, function () {
            lines.forEach(function (line, i) {
              anims.push(m.animate(line, { opacity: 1 }, { delay: staggerDelay(i, 0.22, 0.05), duration: 0.3 }));
              // Audit progress bars (home-capture-audit): fill from 0 to the
              // target width declared in data-bar-fill when the row appears.
              // Animate transform: scaleX (motion/mini handles transforms
              // reliably) with transform-origin left; the CSS variable --bar-w
              // holds the target for reduced-motion and no-JS.
              line.querySelectorAll('[data-bar-fill]').forEach(function (bar) {
                var target = bar.getAttribute('data-bar-fill');
                if (target == null) return;
                anims.push(m.animate(bar, { transform: 'scaleX(' + target / 100 + ')' }, { delay: staggerDelay(i, 0.22, 0.05) + 0.1, duration: 0.7, easing: 'ease-out' }));
              });
            });
          }, { amount: 0.3 });
          stops.push(stop);
        });
      }

      // Home hero fade-in chain: badge → p → CTAs, staggered ~150ms, only
      // after the h1 typewriter dispatches 'typewriter:done'. Elements are
      // hidden via Motion (JS-driven) so reduced-motion and no-JS keep them
      // visible immediately.
      function initHeroFadeIn(m, anims) {
        var els = document.querySelectorAll('[data-fade-after-type]');
        if (!els.length) return;
        if (window.__typewriterDone) return; // typing already finished → keep visible
        if (window.__heroFadeHandler) {
          document.removeEventListener('typewriter:done', window.__heroFadeHandler);
        }
        m.animate(els, { opacity: 0, y: 8 }, { duration: 0 });
        window.__heroFadeHandler = function () {
          document.removeEventListener('typewriter:done', window.__heroFadeHandler);
          window.__heroFadeHandler = null;
          els.forEach(function (el, i) {
            anims.push(m.animate(el, { opacity: 1, y: 0 }, { delay: 0.15 * i, duration: 0.45 }));
          });
        };
        document.addEventListener('typewriter:done', window.__heroFadeHandler);
      }

      // Lateral matrix stream behind the hero headline. Decorative only;
      // reduced-motion draws a single static faint grid (no RAF loop).
      function initHeroMatrix() {
        var canvas = document.getElementById('hero-matrix');
        if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;
        var stream = createMatrixStream(canvas, {});
        stream.start();
        window.__heroMatrix = stream;
      }

      // Hero-scoped white invert cursor follower. Blend on the wrapper,
      // positioned with left/top; active only while the pointer is inside
      // the hero. Disabled for reduced motion and non-hover (touch) devices.
      function initHeroCursor() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!window.matchMedia('(hover: hover)').matches) return;
        var hero = document.getElementById('hero');
        var cursor = document.querySelector('.hero-cursor');
        if (!hero || !cursor) return;
        var active = false;
        function onEnter() {
          active = true;
          cursor.classList.add('hero-cursor-active');
        }
        function onLeave() {
          active = false;
          cursor.classList.remove('hero-cursor-active');
        }
        function onMove(e) {
          if (!active) return;
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
        }
        function onOver(e) {
          var target = e.target;
          var interactive = target && target.closest ? target.closest('a, button') : null;
          cursor.classList.toggle('hero-cursor-grow', !!interactive);
        }
        hero.addEventListener('mouseenter', onEnter);
        hero.addEventListener('mouseleave', onLeave);
        window.addEventListener('pointermove', onMove);
        hero.addEventListener('mouseover', onOver);
        window.__heroCursorDispose = function () {
          hero.removeEventListener('mouseenter', onEnter);
          hero.removeEventListener('mouseleave', onLeave);
          window.removeEventListener('pointermove', onMove);
          hero.removeEventListener('mouseover', onOver);
          cursor.classList.remove('hero-cursor-active');
          cursor.style.left = '';
          cursor.style.top = '';
        };
      }

      function disposeHomeMotion() {
        if (window.__homeMotion) {
          window.__homeMotion.stops.forEach(function (s) { s(); });
          window.__homeMotion.anims.forEach(function (a) { a.stop(); });
          window.__homeMotion = null;
        }
        if (window.__heroMatrix) {
          window.__heroMatrix.stop();
          window.__heroMatrix = null;
        }
        if (window.__heroCursorDispose) {
          window.__heroCursorDispose();
          window.__heroCursorDispose = null;
        }
        if (window.__heroFadeHandler) {
          document.removeEventListener('typewriter:done', window.__heroFadeHandler);
          window.__heroFadeHandler = null;
        }
      }

      document.addEventListener('astro:page-load', function () {
        initHomeMotion();
        initHeroMatrix();
        initHeroCursor();
      });

      document.addEventListener('astro:before-swap', function () {
        disposeHomeMotion();
      });
    </script>
    <script is:inline>
      function initTypewriter() {
        var els = document.querySelectorAll('[data-typewriter]');
        if (!els.length) return;
        // Reduced motion: headline stays fully visible, no typing.
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        els.forEach(function(el) {
          var text = el.textContent || '';
          el.textContent = '';
          el.classList.add('typewriter');
          var i = 0;
          function type() {
            if (i < text.length) {
              el.textContent += text[i];
              i++;
              setTimeout(type, 15 + Math.random() * 20);
            } else {
              el.classList.remove('typewriter');
              // home-hero-redesign: signal completion so the hero fade-in
              // chain can start. No behavior change for existing pages.
              // bubbles:true is REQUIRED — the listener lives on document
              // and the event fires on the h1 span deep in the tree.
              window.__typewriterDone = true;
              el.dispatchEvent(new CustomEvent('typewriter:done', { bubbles: true, detail: { el: el } }));
            }
          }
          type();
        });
      }

      document.addEventListener('astro:page-load', function() {
        initTypewriter();
      });
    </script>
  </body>
</html>
