---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/sections/HeroSection.astro';
import SectionButtons from '../../components/layout/SectionButtons.astro';
import { locales, type Locale } from '@/i18n';
export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
---

<!-- D7: no-JS fallback. AOS's CSS zeroes [data-aos] opacity before init; without
     scripting or with scripting disabled, content must stay visible/reachable. -->
<noscript>
  <style>
    [data-aos] {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<BaseLayout locale={locale}>
  <!-- AIDA funnel (single page). Section 1 = Hero (Attention):
       Badge + value prop + above-the-fold funnel.hero.cta.
       Funnel sections arriving in later PRs, in order:
       2 Pain -> Promise | 3 Process (3 steps) | 4 Services preview
       5 Social proof | 6 About/Skills preview | 7 Projects preview
       8 Auditora (Capture) | 9 Precios (BOFU) | 10 FAQ
       11 Contacto / CTA final | 12 FunnelFooter -->
  <HeroSection locale={locale} />
  <SectionButtons locale={locale} />
</BaseLayout>