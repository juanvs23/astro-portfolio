---
import Layout from '../../layouts/SectionLayout.astro';
import AutomationSection from '../../components/sections/AutomationSection.astro';
import { getTranslations, locales, type Locale } from '@/i18n';
export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
const t = await getTranslations(locale);
const seoPages = t.object('seo.pages') as Record<string, string>;
const seoDescriptions = t.object('seo.descriptions') as Record<string, string>;
---

<Layout locale={locale} title={seoPages.automation} description={seoDescriptions.automation}>
  <AutomationSection locale={locale} />
</Layout>
